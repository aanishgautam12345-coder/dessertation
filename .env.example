# -- Database --
DATABASE_URL=postgresql://postgres:changeme_strong_password_here@localhost:5432/jobmatch

# -- Adzuna API --
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# -- Reed.co.uk API --
REED_API_KEY=your_reed_api_key_here

# -- Groq LLM --
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# -- JWT Auth --
# IMPORTANT: Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_real_secret_with_the_command_above
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_BASE_URL=http://localhost:5000
PASSWORD_RESET_EXPIRY_MINUTES=15

# -- Email (Gmail SMTP - free) --
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com
SMTP_TIMEOUT_SECONDS=10

# -- Embedding --
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# -- Scheduler --
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
SCHEDULER_INSTANT_INTERVAL_MINUTES=5
SCHEDULER_DAILY_TIME=09:00
SCHEDULER_WEEKLY_DAY=mon
SCHEDULER_WEEKLY_TIME=09:00
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_DIGEST_LIMIT=5
RECOMMENDED_SEARCH_THRESHOLD=0.35
